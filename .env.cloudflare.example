# ZivoxTV — Cloudflare Pages Environment Variables
# Set ALL of these in: CF Pages Dashboard → Your Project → Settings → Environment Variables

# ── Required ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://zivox-streaming.vercel.app"
TMDB_API_KEY="your_tmdb_api_key_here"

# ── Optional but Recommended ──────────────────────────────────────────────────
GEMINI_API_KEY="your_gemini_api_key_here"
DISCORD_FEEDBACK_WEBHOOK="your_discord_webhook_here"

# ── Notes ─────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_* vars are embedded at build time — set them BEFORE building
# Server-only vars (TMDB_API_KEY, GEMINI_API_KEY) are injected at runtime
# NEXT_PUBLIC_APP_URL: update to your actual domain once known




